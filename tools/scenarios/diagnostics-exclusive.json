{
  "schema": 1,
  "id": "diagnostics-exclusive",
  "source": "synthetic",
  "description": "Virtual diagnostics gate uses runtime-generation ownership; real root Binder tests are separate.",
  "steps": [
    {
      "at_ms": 10,
      "code": "ABS_RX",
      "value": 255,
      "action": "axis",
      "expect": {
        "active_pointers": 1
      }
    },
    {
      "at_ms": 20,
      "action": "diagnostics_on",
      "expect": {
        "active_pointers": 0,
        "diagnostics": true
      }
    },
    {
      "at_ms": 30,
      "code": "BTN_TR2",
      "down": true,
      "action": "button"
    },
    {
      "at_ms": 40,
      "code": "ABS_RX",
      "value": 0,
      "action": "axis",
      "expect": {
        "active_pointers": 0,
        "min_blocked": 2
      }
    },
    {
      "at_ms": 50,
      "action": "diagnostics_off",
      "expect": {
        "active_pointers": 0
      }
    },
    {
      "at_ms": 60,
      "code": "ABS_RX",
      "value": 0,
      "action": "axis",
      "expect": {
        "active_pointers": 0
      }
    },
    {
      "at_ms": 70,
      "code": "ABS_RX",
      "value": 128,
      "action": "axis"
    },
    {
      "at_ms": 80,
      "code": "ABS_RX",
      "value": 255,
      "action": "axis",
      "expect": {
        "active_pointers": 1
      }
    },
    {
      "at_ms": 90,
      "action": "release_all",
      "expect": {
        "active_pointers": 0
      }
    }
  ]
}
